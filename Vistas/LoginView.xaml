<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.LoginView"
             Title="">
    <VerticalStackLayout>



        <Image Source="mercadito.png"
               WidthRequest="200"
               Margin="0,0,0,30"/>

        <Label 
            Text="Iniciar Sesion"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry             
            x:Name="txttelefono"
            Margin="30"
            HorizontalTextAlignment="Center"
            TextTransform="Uppercase" 
            FontAttributes="Bold"
            Placeholder="Celular (10 digitos)"/>


        <Entry
            x:Name="txtcontra"
            Margin="30"
            FontAttributes="Bold"
            IsPassword="true"
            HorizontalTextAlignment="Center"
            Placeholder="Contraseña"/>


        <Button Text="Ingresar"
                Margin="30"
                FontSize="18"
                FontAttributes="Bold"
                Clicked="Button_Clicked"
                CornerRadius="30"/>


        <Button Text="Registrarse"
        Margin="10"
        FontSize="18"        
                BackgroundColor="White"
                TextColor="Black"
        CornerRadius="30"/>

    </VerticalStackLayout>
</ContentPage>