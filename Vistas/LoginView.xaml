<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.LoginView"
             Title="">
    <VerticalStackLayout>



        <Image Source="comerbanner.png"
               WidthRequest="200"
               Margin="0,0,0,30"/>

        <Label 
            Text="Iniciar Sesion"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry             
            x:Name="txtusuario"
            Margin="30"
            HorizontalTextAlignment="Center"
            TextTransform="Uppercase" 
            FontAttributes="Bold"            
            Placeholder="Usuario"/>


        <Entry
            x:Name="txtcontra"
            Margin="30"
            FontAttributes="Bold"
            IsPassword="true"
            HorizontalTextAlignment="Center"
            Placeholder="Contraseña"/>
        
        
        <ActivityIndicator
      x:Name="actividad"
      />

        <Button 
            x:Name="btningresar"
            Text="Ingresar"
                Margin="30"
                FontSize="18"
                FontAttributes="Bold"
                Clicked="Button_Clicked"
                CornerRadius="30"/>


      


        <Button 
            x:Name="btnregistrer"
            Text="Registrarse"
        Margin="10"
        FontSize="18"        
                BackgroundColor="White"
                TextColor="Black"
        CornerRadius="30"
            Clicked="btnregistrer_Clicked"
            />
        
        

    </VerticalStackLayout>
</ContentPage>