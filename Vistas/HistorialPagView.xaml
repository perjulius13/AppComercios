<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.HistorialPagView"
             Title="Historial de Pagos">
    <VerticalStackLayout>



        <CollectionView
            x:Name="cvComercios"
            SelectionMode="Single"
            Margin="30"
            ItemsSource="{Binding pagos}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

              

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label
                                Text="{Binding Id, StringFormat='ID {0}'}"
                                
                                FontSize="20"
                                FontAttributes="Bold"/>

                            <Label
                                Grid.Row="1"
                                Text="{Binding Cantidad, StringFormat='Pago $ {0}' }"/>

                            <Label
                                Grid.Row="2"
                                Text="{Binding FechaPag}"
                                TextColor="Gray"/>

                            <Label
                                Grid.Row="3"
                                Text="{Binding Plaza}"
                                TextColor="Green"/>

                        </Grid>

                  

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>



    </VerticalStackLayout>
</ContentPage>