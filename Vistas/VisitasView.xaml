<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.VisitasView"
             Title="Tus visitas pendientes">
    
    <VerticalStackLayout Margin="20">


        <ActivityIndicator x:Name="actividad"/>


        <CollectionView
 ItemsLayout="VerticalList"
 x:Name="lstcomercios"
 SelectionChanged="lstcomercios_SelectionChanged"
SelectionMode="Single"
 >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                 Margin="10"                            
                 >

                        <VerticalStackLayout>


                            <Label Text="{Binding Idcomercio, StringFormat='ID: {0}' }"/>
                            
                            <Label Text="{Binding NombreComer, StringFormat='Comercio: {0}' }"/>

                            <Label Text="{Binding  Zona, StringFormat='Zona: {0}'}"/>
                            

                        </VerticalStackLayout>



                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>




    </VerticalStackLayout>
</ContentPage>