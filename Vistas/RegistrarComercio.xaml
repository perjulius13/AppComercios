<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.RegistrarComercio"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             Title="Registrar Comercio">

    <ScrollView >


        <StackLayout >


            <Label 
            Text="Llena los datos correctamente por favor"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />


            <ActivityIndicator x:Name="actividad"/>


            <VerticalStackLayout Margin="20" Spacing="4">

                <Label Text="Datos del comercio"
                   Padding="10"/>

                <Entry
                    x:Name="txtnombre"
                    Placeholder="Nombre del Comercio"
                    TextTransform="Uppercase"
    />


                <Picker x:Name="cbtipocomercio"
                Title="Selecciona el Tipo de Comercio">
                </Picker>


                <Picker x:Name="cbcategoria"
                    Title="Selecciona el Giro">
                </Picker>




                <Entry 
                x:Name="txtlicencia"
                Placeholder="Licencia Mercantil"
                    TextTransform="Uppercase"
                />

            </VerticalStackLayout>


            <VerticalStackLayout Margin="20" Spacing="4">

                <Label Text="Datos del Propietario"
         Padding="10"/>

                <Entry 
    x:Name="txtpropietarionombre"
    Placeholder="Nombre del Propietario"
                    TextTransform="Uppercase"
    />

                <Entry 
x:Name="txttelefonoprop"
Placeholder="Telefono del Propietario"
                   Keyboard="Telephone"
/>

                <Entry 
x:Name="txtemailprop"
Placeholder="Email del Propietario"
                    TextTransform="Uppercase"
/>


            </VerticalStackLayout>



            <VerticalStackLayout Margin="20" Spacing="4">

                <Label Text="Ubicacion"/>


                <Entry
                x:Name="txtlatitud"
                    Placeholder="Latitud"
                    IsEnabled="True"
                />

                <Entry
    x:Name="txtlongitud"
                    Placeholder="Longitud"
                    IsEnabled="True"
    />


                <maps:Map x:Name="map" 
             HeightRequest="300"
             IsShowingUser="True"
             
             />

                <Entry
                    x:Name="txtobservaciones"
                    Placeholder="Observaciones "
                    TextTransform="Uppercase"
                    />

            </VerticalStackLayout>


            <Button 
                x:Name="btnRegistrar"
            Text="Registrar"
            Clicked="Button_Clicked"
                Margin="30"
            />



        </StackLayout>






    </ScrollView>
</ContentPage>