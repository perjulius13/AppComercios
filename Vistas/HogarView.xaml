<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.HogarView"
             Title="Home">
    <VerticalStackLayout>
        
        <Label 
            x:Name="txtnombre"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />


        <ActivityIndicator
            x:Name="actividad"
            />

        <Grid             
    Margin="20,30,20,10"
    RowSpacing="15"
    ColumnSpacing="10"
      >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <VerticalStackLayout Grid.Column="0" Grid.Row="0"
                         HeightRequest="100"                                 
                         BackgroundColor="Azure"
                         >

                <Image
            Source="facturas.png"
            Margin="10"
            />

                <Label
            Text="Pendientes de Pago"
            HorizontalOptions="Center"                    
            />

                <Label
             x:Name="txtpendientes"
            HorizontalOptions="Center"
            FontAttributes="Bold"
                    />
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Column="1" Grid.Row="0"
                         HeightRequest="100"                                 
                          BackgroundColor="Azure"                                 
                         >
        


                <Image
            Source="calendario.png"
            Margin="10"
            />

                <Label                    
                    Text="Visitas"
                    HorizontalOptions="Center"
                    />

                <Label
                     x:Name="txtvistias"
                    HorizontalOptions="Center"
                                FontAttributes="Bold"
                            />
            </VerticalStackLayout>



            <VerticalStackLayout Grid.Column="0" Grid.Row="1"
             HeightRequest="100"                                 
                BackgroundColor="Azure"
             >

                

                <Image
            Source="alfiler.png"
            Margin="10"
            />

                <Label
Text="Total de Comercios"
HorizontalOptions="Center"
/>

                <Label
 x:Name="txttotalcomers"
HorizontalOptions="Center"
            FontAttributes="Bold"
        />
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Column="1" Grid.Row="1"
             HeightRequest="100"                                 
            BackgroundColor="Azure"
             >
                <Image
            Source="aviso.png"
            Margin="10"
            />

                <Label
Text="Avisos"
HorizontalOptions="Center"
/>

                <Label
 Text="2 Nuevos"
HorizontalOptions="Center"
            FontAttributes="Bold"
        />

            </VerticalStackLayout>


        </Grid>


    </VerticalStackLayout>
</ContentPage>