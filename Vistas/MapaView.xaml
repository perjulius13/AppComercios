<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.MapaView"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             Title="Mapa">
    
    <VerticalStackLayout 
        Margin="20">

        <Label Text="Listado de Plazas"
               HorizontalOptions="Center"               
               Padding="10"
               />

        <maps:Map x:Name="map" 
                  HeightRequest="500"
                  IsShowingUser="True"
                  
                  />

        <Label 
            x:Name="txtTotal"
            Padding="5"
            HorizontalOptions="Center"
            />

        <Label 
    x:Name="txtocupadas"
            Padding="5"
            HorizontalOptions="Center"
    />



    </VerticalStackLayout>
</ContentPage>