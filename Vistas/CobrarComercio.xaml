<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.CobrarComercio"
             Title="Cobrar de Licencia de Funcionamiento">
    
    <VerticalStackLayout Margin="30" Spacing="12">
        
        <Label 
            Text="Llena los datos correctamente"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />



        <Label Text="Id del comercio"/>

        <Entry 
            x:Name="txtidcomer"
            IsEnabled="False"
            />


        <Label Text="Nombre del Comercio"/>

        <Entry 
    x:Name="txtnombrecomer"
            IsEnabled="False"
    />

        <Label Text="Años de adeudo"/>

        <Picker x:Name="cbyears"
                  SelectedIndexChanged="PickerCiudades_SelectedIndexChanged"
                >
            
        </Picker>

        <Label Text="Costo de la Licencia"/>
        
        <Entry 
            x:Name="txtcostolic"
            IsEnabled="False"
            />


        <Label Text="Total"/>

        <Entry
            x:Name="txttotal"
            />


        <Button 
            Text="Realizar Pago"
                Clicked="Button_Clicked"
                />







    </VerticalStackLayout>
</ContentPage>