<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.PerfilView"
             Title="Mi Perfil">
    <VerticalStackLayout>



        <Image Source="usuario.png"
               WidthRequest="80"
               Margin="20"
               />


        <Label 
            Text="Datos del Usuario"
            HorizontalOptions="Center"
            Padding="10"            
            />

        <VerticalStackLayout 
            Margin="30"
            BackgroundColor="AliceBlue">


            <Label 
                Padding="10"
                x:Name="txttelefono"
                Text="Telefono: "/>

            <Label 
                Padding="10"
                x:Name="txtnombre"
                Text="Nombre:  "/>

            <Label 
                Padding="10"
                x:Name="txtapellido"
                Text="Apellidos:"/>


            <Label 
    Padding="10"
    x:Name="txtHabilitado"
    Text="Estatus:"/>

            <Label 
                Padding="10"                
                Text="Tipo de puesto: SIN LUGAR ASIGNADO"/>

        </VerticalStackLayout>
        
        
        
        
        
    </VerticalStackLayout>
</ContentPage>