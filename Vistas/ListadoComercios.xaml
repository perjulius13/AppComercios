<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.ListadoComercios"
             Title="Listado de Comercios">
    
    <VerticalStackLayout Margin="20">


        <ActivityIndicator x:Name="actividad"/>


        <CollectionView
      ItemsLayout="VerticalList"
      x:Name="lstcalendario"
      SelectionChanged="OnCollectionViewSelectionChanged"
     SelectionMode="Single"
      >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                      Margin="10"                            
                      >

                        <VerticalStackLayout>

                            <Label Text="{Binding Nombre, StringFormat='Nombre: {0}' }"/>

                            <Label Text="{Binding Categoriatxt, StringFormat='Categoria: {0}' }"/>

                            <Label Text="{Binding TipoComerciotxt}"/>



                        </VerticalStackLayout>



                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        
    </VerticalStackLayout>
</ContentPage>