<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.HomeView"
             xmlns:mtc="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Home">


    <Page.Behaviors>
        <mtc:StatusBarBehavior StatusBarColor="AliceBlue" StatusBarStyle="LightContent"/>
    </Page.Behaviors>

    
    
    <VerticalStackLayout>


        <Label 
            Text="Bienvenido! Andres Gonzalez "            
            HorizontalOptions="Center"
            FontSize="16"
            FontAttributes="Bold"
            Padding="10"/>


        <Label 
                Text="Tianguis de Perote"
                HorizontalOptions="Start"
            Margin="20,10,0,5"
               />

        <Label 
        Text="18/07/2026"
        HorizontalOptions="Start"
    Margin="20,10,0,5"
       />



        <Grid             
            Margin="20,30,20,10"
            RowSpacing="15"
            ColumnSpacing="10"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <VerticalStackLayout Grid.Column="0" Grid.Row="0"
                                 HeightRequest="100"                                 
                                 BackgroundColor="Azure"
                                 >

                <Image
                    Source="facturas.png"
                    Margin="10"
                    />

                <Label
                    Text="Adeudo"
                    HorizontalOptions="Center"                    
                    />

                <Label
                     Text="$ 200"
                    HorizontalOptions="Center"
                    FontAttributes="Bold"
                            />
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Column="1" Grid.Row="0"
                                 HeightRequest="100"                                 
                                  BackgroundColor="Azure"                                 
                                 >
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </VerticalStackLayout.GestureRecognizers>


                <Image
                    Source="calendario.png"
                    Margin="10"
                    />

                <Label
        Text="Proximo dia"
        HorizontalOptions="Center"
        />

                <Label
         Text="Lunes"
        HorizontalOptions="Center"
                    FontAttributes="Bold"
                />
            </VerticalStackLayout>



            <VerticalStackLayout Grid.Column="0" Grid.Row="1"
                     HeightRequest="100"                                 
                        BackgroundColor="Azure"
                     >
                
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                </VerticalStackLayout.GestureRecognizers>
                
                <Image
                    Source="alfiler.png"
                    Margin="10"
                    />

                <Label
        Text="Lugar"
        HorizontalOptions="Center"
        />

                <Label
         Text="15 (3 mts)"
        HorizontalOptions="Center"
                    FontAttributes="Bold"
                />
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Column="1" Grid.Row="1"
                     HeightRequest="100"                                 
                    BackgroundColor="Azure"
                     >
                <Image
                    Source="aviso.png"
                    Margin="10"
                    />

                <Label
        Text="Avisos"
        HorizontalOptions="Center"
        />

                <Label
         Text="2 Nuevos"
        HorizontalOptions="Center"
                    FontAttributes="Bold"
                />

            </VerticalStackLayout>


        </Grid>









    </VerticalStackLayout>
</ContentPage>