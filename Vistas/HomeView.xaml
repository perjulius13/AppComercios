<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.HomeView"
             Title="Home">
    <VerticalStackLayout>
        
        
        <Label 
            Text="Bienvenido! "            
            HorizontalOptions="Center" />



        <VerticalStackLayout Margin="30" 
                             BackgroundColor="#f2f5f5"
                             HeightRequest="300"
                             >
            
            <Label 
                Text="Pagos pendientes:"            
                HorizontalOptions="Center"
                Padding="10"/>

            <Label 
    Text="No hay pendientes"            
    HorizontalOptions="Center"
    Padding="10"/>


            <Button 
    Text="Realizar Pago"
        Margin="10,20,10,20"
                CornerRadius="20"
    />


        </VerticalStackLayout>



        <Button 
    Text="Consulta tu agenda"
        Margin="30"
                CornerRadius="20"
           
            Clicked="Button_Clicked"
    />




    </VerticalStackLayout>
</ContentPage>