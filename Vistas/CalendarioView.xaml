<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.CalendarioView"
             Title="CalendarioView">
    <VerticalStackLayout>



        <ActivityIndicator x:Name="actividad"/>

        <Label 
            Text="Calendario de Trabajo"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <CollectionView
            ItemsLayout="VerticalList"
            x:Name="lstcalendario"
            SelectionChanged="OnCollectionViewSelectionChanged"
           SelectionMode="Single"
            >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            Margin="10"                            
                            >

                        <VerticalStackLayout>
                            
                            <Label Text="{Binding NumeroPlaza, StringFormat='Plaza: {0}' }"/>

                            <Label Text="{Binding FechaAsig, StringFormat='Fecha: {0}' }"/>

                            <Label Text="{Binding Pagado, StringFormat='Estatus del pago: {0}' }"/>
                            
                        </VerticalStackLayout>

                        

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>








    </VerticalStackLayout>
</ContentPage>