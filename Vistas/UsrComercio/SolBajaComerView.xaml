<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.UsrComercio.SolBajaComerView"
             Title="Solicitud de Baja">
    
    <VerticalStackLayout Margin="20">


        <Label 
            Text="Ingresa los datos correctamente"
            HorizontalOptions="Center"
               />


        <Label Text="Id del comercio"
               Margin="0,20,0,0"
               />
        
        <Entry 
            Placeholder="Id del comercio"
               Keyboard="Numeric"  
            x:Name="txtcomercio"
               />

        <Button
            Text="Buscar"
            Margin="30,10,30,10"
            Clicked="Button_Clicked"
            />
        
        
        



    </VerticalStackLayout>
</ContentPage>