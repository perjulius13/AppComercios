<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.UsrComercio.SolBajaComerView"
             Title="Solicitud de Baja">
    
    <VerticalStackLayout Margin="20">


        
        
        
        
        <Label 
            Text="Ingresa los datos correctamente"
            HorizontalOptions="Center"
               />


        <Label Text="Selecciona el comercio"
               Margin="10"
               />
        
       
        <Picker x:Name="combocomercios"
                Margin="10"
                />



        <Label
            Text="Describa el motivo de baja del comercio"
            Margin="20"
            HorizontalOptions="Center"
            />


        <Entry
            x:Name="txtmotivo"
            Placeholder="100 caracteres"
            Margin="10"
            />



        <Button
            Text="Enviar Solicitud de Baja"
            Margin="30"
            Clicked="Button_Clicked"
            />
        
        
        



    </VerticalStackLayout>
</ContentPage>