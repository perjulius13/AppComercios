<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.UsrComercio.PagosListComerView"
             Title="Listado de Pagos">
    
    <VerticalStackLayout>
        
        
        <Label 
            Text="En este listado se muestran tus ultimos 10 pagos"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />



        <CollectionView
 ItemsLayout="VerticalList"
 x:Name="lstPagos"
 
SelectionMode="Single"
 >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                 Margin="10"                            
                 >

                        <VerticalStackLayout>

                            <Label Text="{Binding IdPeticion, StringFormat='Folio: {0}' }"/>

                            <Label Text="{Binding Cantidad, StringFormat='Cantidad: {0}' }"/>

                            <Label Text="{Binding Importe, StringFormat='Importe: {0}' }"/>

                            <Label Text="{Binding Fechapago, StringFormat='Fecha de Pago: {0}' }"/>


                        </VerticalStackLayout>



                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        
        
        





    </VerticalStackLayout>
    
</ContentPage>