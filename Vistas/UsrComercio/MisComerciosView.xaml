<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppComercios.Vistas.UsrComercio.MisComerciosView"
    Title="Mis Comercios"
    BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="Auto,*"
          Padding="20,15,20,0">

        <!-- ENCABEZADO -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="4"
                             Margin="5,0,5,15">

            <Label
                Text="Listado de Comercios"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1C1C1C"/>

            <Label
                Text="Comercios registrados a tu nombre"
                FontSize="14"
                TextColor="#777777"/>

        </VerticalStackLayout>


        <!-- LISTADO -->
        <CollectionView
            Grid.Row="1"
            x:Name="lstComercios"
            SelectionChanged="OnCollectionViewSelectionChanged"
            SelectionMode="Single"
            
            SelectionChangedCommandParameter="{Binding SelectedItem}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E3E6EA"
                        StrokeThickness="1"
                        Padding="15"
                        Margin="3,0,3,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#000000"
                                Offset="0,3"
                                Radius="8"
                                Opacity="0.10"/>
                        </Border.Shadow>

                        <Grid
                            ColumnDefinitions="60,*,30"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="12"
                            RowSpacing="5">

                            <!-- ICONO -->
                            <Border
                                Grid.RowSpan="3"
                                Grid.Column="0"
                                BackgroundColor="#E8F1FF"
                                WidthRequest="55"
                                HeightRequest="55"
                                Padding="8"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28"/>
                                </Border.StrokeShape>

                                <Image
                                    Source="storefront.png"
                                    Aspect="AspectFit"/>
                            </Border>


                            <!-- NOMBRE -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding NombreComer}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#1C1C1C"
                                LineBreakMode="TailTruncation"/>


                            <!-- ID -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Idcomercio, StringFormat='ID de comercio: {0}'}"
                                FontSize="12"
                                TextColor="#888888"/>


                            <!-- ZONA Y TIPO -->
                            <HorizontalStackLayout
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="15">

                                <Label
                                    Text="{Binding Zona, StringFormat='Zona: {0}'}"
                                    FontSize="13"
                                    TextColor="#555555"/>

                                <Label
                                    Text="{Binding TipoComercio, StringFormat='Tipo: {0}'}"
                                    FontSize="13"
                                    TextColor="#555555"/>

                            </HorizontalStackLayout>


                            <!-- FLECHA -->
                            <Label
                                Grid.RowSpan="3"
                                Grid.Column="2"
                                Text="›"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#1C59AF"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
    
