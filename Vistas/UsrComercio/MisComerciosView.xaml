<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.UsrComercio.MisComerciosView"
             Title="Mis Comercios ">
    <VerticalStackLayout>



        <CollectionView
 ItemsLayout="VerticalList"
 x:Name="lstComercios"
 
SelectionMode="Single"
 >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                 Margin="10"                            
                 >

                        <VerticalStackLayout>

                            <Label Text="{Binding Idcomercio, StringFormat='ID: {0}' }"/>
                            
                            <Label Text="{Binding NombreComer, StringFormat='Nombre: {0}' }"/>

                            <Label Text="{Binding Zona, StringFormat='Zona: {0}' }"/>

                            <Label Text="{Binding TipoComercio, StringFormat='Tipo: {0}' }"/>

                            


                        </VerticalStackLayout>



                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </VerticalStackLayout>
</ContentPage>