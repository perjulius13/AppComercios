<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.UsrComercio.ComercioDetailView"             
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             Title="Mi Comercio">


    <ScrollView>

        <VerticalStackLayout Margin="20">


            <ActivityIndicator x:Name="actividad"/>

            <Label 
            Text="Datos del Comercio!"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Padding="10"/>


            <Grid RowSpacing="10"
              ColumnSpacing="10"
              Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>


                <StackLayout 
                Grid.Column="0" Grid.Row="0"                
                >

                    <Label Text="Nombre"
                       HorizontalOptions="Center"
                       
                       />

                </StackLayout>

                <StackLayout 
                Grid.Column="1" 
                         Grid.Row="0">

                    <Label 
                    x:Name="txtnombrecomer"
                    HorizontalOptions="Center"
                    FontAttributes="Bold"
                       />

                </StackLayout>


                <StackLayout 
    Grid.Column="0" Grid.Row="1"                
    >

                    <Label Text="Giro"
           HorizontalOptions="Center"
           />

                </StackLayout>

                <StackLayout 
    Grid.Column="1" Grid.Row="1"                
    >

                    <Label 
                    FontAttributes="Bold"
                    x:Name="txtgiro"
           HorizontalOptions="Center"
           />

                </StackLayout>


                <StackLayout 
    Grid.Column="0" Grid.Row="2"                
    >

                    <Label Text="Licencia Mercantil"
           HorizontalOptions="Center"
           />

                </StackLayout>

                <StackLayout 
Grid.Column="1" Grid.Row="2"                
>

                    <Label 
                    Text="4"
                    FontAttributes="Bold"
       HorizontalOptions="Center"
       />

                </StackLayout>


                <StackLayout 
    Grid.Column="0" Grid.Row="3"                
    >

                    <Label Text="Calle"
           HorizontalOptions="Center"
           />

                </StackLayout>


                <StackLayout 
Grid.Column="1" Grid.Row="3"                
>

                    <Label 
                    x:Name="txtcalle"
       HorizontalOptions="Center"
                    FontAttributes="Bold"
       />

                </StackLayout>

                <StackLayout 
    Grid.Column="0" Grid.Row="4"                
    >
                    <Label Text="Pago"
           HorizontalOptions="Center"
           />

                </StackLayout>

                <StackLayout 
    Grid.Column="1" Grid.Row="4"                
    >

                    <Label 
                    x:Name="txtestatuspag"
           HorizontalOptions="Center"
                    FontAttributes="Bold"
           />

                </StackLayout>


                <StackLayout 
Grid.Column="0" Grid.Row="5"                
>
                    <Label Text="Propietario"
       HorizontalOptions="Center"
       />

                </StackLayout>

                <StackLayout 
Grid.Column="1" Grid.Row="5"                
>

                    <Label 
                x:Name="txtpropietario"
       HorizontalOptions="Center"
                FontAttributes="Bold"
       />

                </StackLayout>

            </Grid>








            <Label
            Text="Ubicacion"
            HorizontalOptions="Center"
            Padding="10"
            />


            <maps:Map x:Name="map" 
              HeightRequest="300"
              
              />


            <VerticalStackLayout Margin="20">

                <Label Text="Completa los datos"
            HorizontalOptions="Center"
                       Margin="10"
                       />

                <Label Text="Licencia Mercantil"/>
                <Entry 
 Placeholder="Licencia Mercantil"
                    x:Name="txtlicenciamer"

 />



                <Label Text="Telefono del Propietario"/>
                <Entry Placeholder="telefono"
                       x:Name="txttelpropietario"
                       Keyboard="Telephone"
                       />

                <Label Text="Email del Propietario"/>
                <Entry Placeholder="telefono"                            
                       x:Name="txtemailprop"
    />

                <Label Text="Dimensiones del Local"/>
                <Entry Placeholder="Dimensiones"
                       x:Name="txtdimensiones"
                       />

                <Label Text="Numero"/>
                <Entry Placeholder="Numero"
                       x:Name="txtnumerodir"/>





                <Button  Text="Actualizar Datos" 
      Margin="30"
      Clicked="Button_Clicked"
      />





            </VerticalStackLayout>





        </VerticalStackLayout>


    </ScrollView>


    


</ContentPage>