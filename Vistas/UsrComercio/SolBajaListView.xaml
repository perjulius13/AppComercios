<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppComercios.Vistas.UsrComercio.SolBajaListView"
             Title="Solicitud de Baja">
    
    <VerticalStackLayout Margin="20">


        <Button Text="Nueva Solicitud"
                Clicked="Button_Clicked"
                Margin="30"/>



        <Label Text="Listado de Solicitudes"
               HorizontalOptions="Center"/>


        <ActivityIndicator x:Name="actividad"/>

        <CollectionView
 ItemsLayout="VerticalList"
 x:Name="lstbajas"
 
SelectionMode="Single"
 >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                 Margin="10"                            
                 >

                        <VerticalStackLayout>

                            <Label Text="{Binding Idcomercio, StringFormat='ID: {0}' }"/>

                            <Label Text="{Binding NombreComer, StringFormat='Nombre: {0}' }"/>

                            <Label Text="{Binding Respuesta, StringFormat='Respuesta: {0}' }"/>


                        </VerticalStackLayout>



                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>




    </VerticalStackLayout>
</ContentPage>