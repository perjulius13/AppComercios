<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppComercios.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppComercios"
    xmlns:vistas="clr-namespace:AppComercios.Vistas"    
    Title="AppComercios">



    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Grid              
                Background="LightSlateGray"
                  HeightRequest="100">
                
                <Label Text="Comercios Perote"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

              

            </Grid>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>
    
    


    <FlyoutItem
    Title="Home"    
        Icon="casa.png"
    >


        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate vistas:HogarView}"
            Icon="hogar.png"
            />

        <ShellContent
            Title="Mapa"
            ContentTemplate="{DataTemplate vistas:MapaComercios}"
            Icon="mapa.png"
            />
            
            <ShellContent
            Title="Pagos"
            ContentTemplate="{DataTemplate vistas:HistorialPagView}"
            Icon="dinero.png"
            />


          <ShellContent
            Title="Registrar Comercio"
            ContentTemplate="{DataTemplate vistas:RegistrarComercio}"
            Icon="plaza.png"
            />


    </FlyoutItem>


    <ShellContent 
        Title="Mi perfil"
        ContentTemplate="{DataTemplate vistas:PerfilView}"
        Icon="profile.png"
        />

    <ShellContent 
    Title="Ayuda"
    ContentTemplate="{DataTemplate vistas:AyudaView}"
        Icon="informacion.png"
    />




    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <Button Text="Cerrar Sesion"
                    Margin="10"
                    CornerRadius="20"
                    BackgroundColor="LightSlateGray"
                    Clicked="Button_Clicked"
                    />
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>






</Shell>
