<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppComercios.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppComercios"
    xmlns:vistas="clr-namespace:AppComercios.Vistas"
    Title="AppComercios">




    <FlyoutItem
    Title="Home"    
    Route="ProductivityTools">


        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate vistas:HomeView}"
            Icon="dotnet_bot.png"
            />

        <ShellContent
            Title="Mapa"
            ContentTemplate="{DataTemplate vistas:MapaView}"
            Icon="dotnet_bot.png"
            />
            
            <ShellContent
            Title="Pagos"
            ContentTemplate="{DataTemplate vistas:RealizarPago}"
            Icon="dotnet_bot.png"
            />
            
        
    </FlyoutItem>


    <ShellContent 
        Title="Mi perfil"
        ContentTemplate="{DataTemplate vistas:PerfilView}"
        />






</Shell>
